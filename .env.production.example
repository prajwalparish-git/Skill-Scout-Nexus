# Variables for a LIVE deployment (backend on Render, frontend on Vercel) — see
# README.md > Deployment. For every other option (offline mode, Ollama, ElevenLabs, SMTP, local
# speech-to-text, ...) see the fully-documented .env.example; this file is only the production
# subset. Never commit the real .env — copy this file, fill it in, and set the values as secrets
# in Render's and Vercel's own dashboards instead of shipping them in the image or the repo.

# ============================================================================
# Backend (server.py on Render) — set these in Render's "Environment" tab.
# Rendered automatically by render.yaml; this file documents what each one is for.
# ============================================================================

# Live AI, not the offline mock answers.
MOCK_MODE=false

# The deployed frontend's origin(s), comma-separated, no trailing slash — this is the CORS
# allow-list (server.py: cors_origins()). Without it the browser blocks every API call.
FRONTEND_ORIGINS=https://your-app.vercel.app

# At least one of these two AI providers (console.groq.com/keys, aistudio.google.com/apikey).
# Comma-separated for a key pool; see .env.example for how the fallback order works.
GROQ_API_KEYS=
GEMINI_API_KEYS=

# Recommended: a hosted Postgres URL (e.g. Supabase) so student records outlive a redeploy
# without depending on the Render disk. DATABASE_URL and SUPABASE_DB_URL are interchangeable
# (piq/config.py); DATABASE_URL wins if both are set. Leave both blank to fall back to the
# SQLite file on the persistent disk that render.yaml mounts at /data.
DATABASE_URL=
SUPABASE_DB_URL=

# Only read when DATABASE_URL/SUPABASE_DB_URL is blank — points the SQLite fallback at the
# mounted disk (render.yaml) instead of the container's writable layer, which Render discards
# on every restart and redeploy.
DB_PATH=/data/placementiq.db
TELEMETRY_DB_PATH=/data/placement_nexus.db

# Optional, same as in .env.example: emails sign-up codes and org welcome emails instead of
# writing them to data/.mail_outbox.log (which would be lost between deploys).
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# ============================================================================
# Frontend (frontend/ on Vercel) — set this in Vercel's Project -> Settings -> Environment
# Variables, not in a committed file (frontend/.env.local is for local dev only, is gitignored,
# and Vercel never reads it).
# ============================================================================

# The Render service's public URL from above, no trailing slash. Baked in at build time
# (frontend/lib/api.ts), so changing it needs a redeploy, not just a restart.
NEXT_PUBLIC_API_URL=https://your-api.onrender.com
