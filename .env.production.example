# Variables for a LIVE deployment (backend on Render, frontend on Vercel) — see
# README.md > Deployment. For every other option (offline mode, Ollama, ElevenLabs, SMTP, local
# speech-to-text, ...) see the fully-documented .env.example; this file is only the production
# subset. Never commit the real .env — copy this file, fill it in, and set the values as secrets
# in Render's and Vercel's own dashboards instead of shipping them in the image or the repo.

# ============================================================================
# Backend (server.py on Render) — set these in Render's "Environment" tab.
# Rendered automatically by render.yaml; this file documents what each one is for.
# ============================================================================

# Live AI, not the offline mock answers.
MOCK_MODE=false

# The deployed frontend's origin(s), comma-separated, no trailing slash. The frontend calls the API
# through its own /api proxy, so this is only needed if something calls the API from a browser
# on another origin directly (server.py: cors_origins()).
FRONTEND_ORIGINS=https://your-app.vercel.app

# The public address of the web app (the buttons and Terms / Privacy links in every email).
APP_URL=https://your-app.vercel.app

# Strong, secret, and kept the same across deploys: mixed into every password hash and used to
# sign the sign-in steps. Make one with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_PEPPER=

# Never a single-student copy in production, even before SMTP is set up.
LOCAL_MODE=false

# At least one of these two AI providers (console.groq.com/keys, aistudio.google.com/apikey).
# Comma-separated for a key pool; see .env.example for how the fallback order works.
GROQ_API_KEYS=
GEMINI_API_KEYS=

# Optional: a hosted Postgres URL (e.g. Supabase's pooler URL) that receives a background copy of
# the telemetry (resume scans, plans, quizzes, voice sessions) for the faculty dashboard.
# DATABASE_URL and SUPABASE_DB_URL are interchangeable; DATABASE_URL wins if both are set.
# It does NOT hold accounts, sign-in sessions or the app's own records: those are never synced.
DATABASE_URL=
SUPABASE_DB_URL=

# Always used, with or without DATABASE_URL: the app database (accounts, sessions, plans, quiz
# history) and the telemetry's local copy are SQLite files. Left unset (the free-tier demo in
# render.yaml) they live under data/ inside the container, which the host wipes on every
# deploy, restart and idle spin-down, so demo accounts do not last. On a paid plan with the
# persistent disk from render.yaml mounted at /data, point them there to keep every account:
# DB_PATH=/data/placementiq.db
# TELEMETRY_DB_PATH=/data/placement_nexus.db

# Optional: where the AI prompt cache, spoken-question audio and preloaded pages are kept
# (defaults: under data/). With a disk, point them at it too to keep them across deploys.
# AI_CACHE_PATH=/data/.ai_cache.json
# AUDIO_CACHE_DIR=/data/.audio_cache
# PRELOAD_CACHE_DIR=/data/.preload_cache

# Optional: force the Secure flag on the sign-in cookies (true / false). By default it follows
# the request: Secure behind HTTPS (X-Forwarded-Proto: https), not on plain http://localhost.
# COOKIE_SECURE=true

# Optional, same as in .env.example: emails sign-up codes and org welcome emails instead of
# writing them to data/.mail_outbox.log (which would be lost between deploys).
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# ============================================================================
# Frontend (frontend/ on Vercel) — set this in Vercel's Project -> Settings -> Environment
# Variables, not in a committed file (frontend/.env.local is for local dev only, is gitignored,
# and Vercel never reads it).
# ============================================================================

# The Render service's public URL from above, no trailing slash. The Next.js server forwards
# every /api/* request here (frontend/next.config.mjs), so the browser only talks to your own
# domain and the sign-in cookie is first-party. Read when the site starts: changing it needs a
# redeploy.
API_ORIGIN=https://your-api.onrender.com

# Optional: where the Streamlit app runs (the organization admin portal the site links to).
# Baked in at build time.
# NEXT_PUBLIC_APP_URL=https://your-streamlit-app.example.com
