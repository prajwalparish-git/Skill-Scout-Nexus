# Copy to .env and fill in what you need. Never commit .env.
#
# ONLY GROQ AND/OR GEMINI ARE NEEDED FOR CLOUD AI. Everything else is optional and falls back
# on its own, silently: no key -> the next provider; every key rate-limited -> the next
# provider; nothing reachable -> a local Ollama, then built-in answers from data/ (the
# question bank, role skills, interview tracks). The app never asks for a key on screen.
#
# Tiers are tried in this order (core/ai_router.py). Speed first: Groq, then Gemini, then local.
AI_PROVIDERS=groq,gemini,ollama
# true = turn on live AI. false here keeps the offline demo answers (nothing calls a network).
MOCK_MODE=true

# --- 1. Groq: the fastest cloud tier ------------------------------------------------------------
# One key, or a pool separated by commas; requests take the keys in turn, and a key that hits
# its rate limit rests for 60 s while the next one answers. Keys: console.groq.com/keys
#   GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
# (GROQ_API_KEY=gsk_key1 works too, and joins the pool.) Groq limits quota per organisation:
# keys from the same organisation share it. Groq also transcribes spoken answers (Whisper).
GROQ_API_KEYS=
# Model IDs change; never hard-code them. These are Groq's recommended successors to the Llama
# 3.x models it retired on 2026-08-16; verified 2026-10-19 with the real agents.
# Re-check any time: python -m scripts.check_models
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
# Seconds before a request moves on to the next tier. Raise it (e.g. 15) if long answers such
# as a 10-question quiz keep falling through.
GROQ_TIMEOUT_S=4.0

# --- 2. Google Gemini: the high-capacity cloud tier ---------------------------------------------
# One key or a comma-separated pool, rotated like Groq's. Keys: aistudio.google.com/apikey
# The same keys also power Gemini TTS (spoken questions) and Gemini transcription (see Voice).
#   GEMINI_API_KEYS=AIza_key1,AIza_key2
GEMINI_API_KEYS=
# Verified 2026-11-07 against ai.google.dev/gemini-api/docs/models. (gemini-2.5-flash is only
# served to keys that used it before; gemini-2.0-flash was shut down on 2026-06-01.)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=5.0

# --- 3. Ollama: a local model, works with no internet -------------------------------------------
# Install from ollama.com, then: ollama pull llama3.2:3b . Leave the URL blank to skip Ollama.
# A 200 ms ping decides whether it is running; the model stays loaded between requests.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Context and answer budget, small for speed. Raise OLLAMA_NUM_PREDICT (e.g. 1536) if long
# answers come back cut off.
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=512

# --- 3b. A student's own local model (Settings > My local model) --------------------------------
# Lets each signed-in student point the app at Ollama or LM Studio on THIS computer, used first
# when they choose, or when the cloud AI fails or there is no network. Only localhost /
# 127.0.0.1 / ::1 addresses are accepted and redirects are never followed, whatever this says.
# auto (default): on only in LOCAL_MODE (a single-student copy on one laptop). false: off.
# true: on even when LOCAL_MODE is off (e.g. a laptop that also uses SMTP or cloud sync).
# WARNING: never set LOCAL_AI=true on a public or shared server (Render, a VPS, a lab machine
# others can reach): it lets that server call services on its own localhost for any student.
# It is always off when the RENDER environment variable is present.
# LOCAL_AI=auto

# --- Voice out: who speaks the interview questions (optional) -----------------------------------
# Tiers, tried in order (core/speech_router.py). Every clip is cached in data/.audio_cache/, so a
# question is never generated twice, and a cached clip plays even with no internet.
#   1. ElevenLabs   only when ELEVENLABS_API_KEY is set (below).
#   2. Gemini TTS   the ElevenLabs alternative. It reuses GEMINI_API_KEYS from section 2 (same
#                   key pool, so no extra key). With no ElevenLabs key it is the first tier.
#   3. Local voice  pyttsx3, the machine's own voice. Works with no internet.
#                   (pip install -r requirements-offline.txt)
#   4. Browser      the browser's Web Speech voice, the last resort. Always available.
# No internet: tiers 1 and 2 are skipped at once (no waiting for timeouts) and tier 3 speaks.
#
# Gemini TTS models. Both verified 2026-11-10 against the live models list. The first is tried
# on every key; if it fails or Google does not serve it, the second (lighter, faster) is tried.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-lite-tts
# One of Gemini's prebuilt voices, e.g. Kore, Puck, Charon, Aoede, Fenrir, Leda, Zephyr.
GEMINI_TTS_VOICE=Kore
# Seconds to wait for one speech request before the next key, model or tier is tried.
GEMINI_TTS_TIMEOUT_S=12.0
#
# ElevenLabs (optional; leave blank to use Gemini TTS instead).
ELEVENLABS_API_KEY=
# Blank voice = a premade voice; blank model = ElevenLabs' current default model.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# --- Voice in: transcribing a spoken answer (optional) ------------------------------------------
# Tiers, tried in order (core/transcribe_router.py): Groq Whisper (GROQ_API_KEYS), then Gemini
# (GEMINI_API_KEYS + GEMINI_MODEL), then faster-whisper on this machine, then the student types.
# The local tier needs no internet and no key:
#   pip install -r requirements-offline.txt
#   python -m scripts.offline_setup     (run once while online: downloads the model)
# base.en is accurate enough for interview answers and runs on a laptop CPU. tiny.en is faster,
# small.en more accurate. Blank turns the local tier off.
LOCAL_STT_MODEL=base.en

# --- Working with no internet at all (summary) --------------------------------------------------
# AI text   Groq -> Gemini -> Ollama (local model, section 3) -> built-in answers from data/
#           (a student's own local model, section 3b, goes first when they prefer it, or
#           first when the network is down, or last before the built-in answers)
# Voice out ElevenLabs -> Gemini TTS -> pyttsx3 (local) -> the browser's voice
# Voice in  Groq Whisper -> Gemini -> faster-whisper (local) -> the student types
# Nothing to switch: each tier is skipped on its own when it has no key or no network.
# Check what is ready:  python -m scripts.offline_setup --check

# --- Accounts and email (optional) --------------------------------------------------------------
# Sign-in sends a 9-digit code by email (and so do sign-up and account recovery), and an
# organization admin's bulk-created students get a welcome email with a temporary password.
# Leave these blank and nothing breaks: each message is written to data/.mail_outbox.log on this
# machine (welcome emails are logged there even when SMTP works, so an admin can hand a lost
# password over) and the page says so, which is enough for local testing.
# To email real codes from Gmail, use an App Password (not your normal password):
#   1. Turn on 2-Step Verification: myaccount.google.com/security
#   2. Open myaccount.google.com/apppasswords, name it "Skill Scout Nexus", press Create.
#   3. Copy the 16-character password Google shows (spaces are fine) into SMTP_APP_PASSWORD.
SMTP_EMAIL=
SMTP_APP_PASSWORD=
# 587 uses STARTTLS; 465 uses implicit TLS. Any SMTP server works (SMTP_HOST), Gmail by default.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# The public address of the web app: the buttons and the Terms / Privacy links in every email.
# APP_URL=http://localhost:8000
# Shown in the email footer when set (a help address students can write to).
# SUPPORT_EMAIL=
# Optional extra secret mixed into every password hash and never stored in the database, so a
# stolen database alone cannot be cracked. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set it once: changing it later makes every password stop working (students then recover
# their accounts with an email code).
AUTH_PEPPER=
# auto (default): with no SMTP and no cloud database this is a single-student copy on one
# computer: one account, password only, no emails. true / false force it either way.
# LOCAL_MODE=auto
# Signing in with this as the password (any username or email) opens the operations page
# (accounts, sign-in log, sessions, AI usage). Empty: there is no way in.
DEV_SECRET=

# --- Google Drive (optional) --------------------------------------------------------------------
# Students connect their own Google Drive; the app keeps a "Skill Scout Nexus" folder there with
# "Certificates" and "Resumes", and serves a certificate from Drive when the local copy is gone
# (a host whose disk is wiped on restart). Leave any of the three blank and the feature is hidden.
# 1. Google Cloud console > APIs & Services: enable the Google Drive API.
# 2. OAuth consent screen: add ONLY the scope .../auth/drive.file (the app then sees only the
#    files it created, never the rest of a student's Drive). In "Testing", only the test users
#    you list can connect; publish the consent screen for everyone.
# 3. Credentials > Create OAuth client ID > "Web application", with these redirect URIs:
#      <APP_URL>/api/drive/callback      (the web app; e.g. http://localhost:8000/api/drive/callback)
#      http://localhost:8000/            (the unified app on this machine)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts each student's Drive refresh token in the database. 32 random bytes, URL-safe base64:
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep it secret and set it once: a new key disconnects every Drive (students connect again).
DRIVE_TOKEN_KEY=
# Only when your callbacks differ from the defaults above:
# GOOGLE_REDIRECT_URI=https://your-site.example/api/drive/callback

# --- Project ideas: GitHub inspiration (optional) -----------------------------------------------
# Repositories come from GitHub's official Search API (metadata only, cached for 24 hours; offline
# the app uses built-in examples). It works without a token at a lower rate limit. A fine-grained
# token with no extra permissions (public data only) raises it.
GITHUB_TOKEN=

# --- Storage (optional) -------------------------------------------------------------------------
DB_PATH=./data/placementiq.db
# Telemetry for the faculty dashboard always lives in a local SQLite file (TELEMETRY_DB_PATH),
# so pages never wait on the network. Set a hosted PostgreSQL such as Supabase and every record
# is also copied there in the background; one made while offline waits and goes up later. Use
# either name (DATABASE_URL wins). Supabase's pooler URL (port 6543) suits it. Example with
# placeholder credentials:
#   SUPABASE_DB_URL=postgresql://postgres.yourproject:password@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=
DATABASE_URL=
TELEMETRY_DB_PATH=./data/placement_nexus.db
# Caches, all optional and under data/ by default: the AI prompt cache, spoken-question audio,
# preloaded pages, and the outbox file that holds emails when SMTP is not set up.
# AI_CACHE_PATH=./data/.ai_cache.json
# AUDIO_CACHE_DIR=./data/.audio_cache
# PRELOAD_CACHE_DIR=./data/.preload_cache
# MAIL_OUTBOX_PATH=./data/.mail_outbox.log
# Force the Secure flag on the API's sign-in cookies (true / false); by default it is set
# behind HTTPS (X-Forwarded-Proto: https) and left off on plain http://localhost.
# COOKIE_SECURE=

# --- Behaviour ----------------------------------------------------------------------------------
# Identical plan, critique and rubric requests are answered from data/.ai_cache.json instantly.
AI_CACHE=true
# true: when no provider answers, serve built-in answers. false: show the error instead (the
# evaluation always runs with false and with the cache off).
AI_OFFLINE_FALLBACK=true
MAX_CRITIC_RETRIES=2
# true: after a resume scan, the roadmap, the first quiz and the voice questions are written in
# the background (data/.preload_cache/), so those pages open at once. false saves AI quota.
# Students opt in under Settings (it is off for each of them until they turn it on, to save
# AI quota); false here turns it off for everyone.
PRELOAD=true

# --- Unified single-port deployment (server.py on http://localhost:8000) ------------------------
# Browser origins allowed to call the API directly, comma-separated. In production, server.py
# serves the Next.js static build directly on http://localhost:8000. In development mode with
# Next.js dev server, http://localhost:3000 is supported.
FRONTEND_ORIGINS=http://localhost:8000,http://localhost:3000
