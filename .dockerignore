# Keep the production image lean, and never bake a developer's local state into it.
# The web app is built in the Dockerfile's first stage; only its static export is copied over.
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/public/mediapipe/
frontend/public/vad/
.venv/
venv/
.tools/
.git/
.github/
tests/
docs/
deploy/
evaluation/
bootstrap.py
/*.md
.claude/
.gemini/
.vscode/
.idea/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
node_modules/

# Secrets: set them in the host's dashboard instead.
.env
.env.*
!.env.example
!.env.production.example

# Local state: databases (accounts, sessions), dev login codes, caches and evaluation output.
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
data/.ai_cache.json
data/.audio_cache/
data/.preload_cache/
data/.mail_outbox.log
# Backups the developer console makes before replacing a data file.
data/.backups/

MCQ.csv*
run.ps1
run.sh
