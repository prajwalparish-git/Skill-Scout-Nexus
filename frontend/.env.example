# Where server.py (uvicorn server:app --port 8000) listens. The browser calls this site's /api/*;
# the Next.js server forwards it here (next.config.mjs).
API_ORIGIN=http://localhost:8000
# Where the Streamlit app (streamlit run app.py) runs: the organization admin portal the site
# links to. Baked in at build time.
NEXT_PUBLIC_APP_URL=http://localhost:8501
